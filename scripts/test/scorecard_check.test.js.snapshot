exports[`run > logs findings and writes nothing to GitHub 1`] = `
"Active repositories: 4 (archived: 1, excluded: 1)\\nScorecard v5.6.0 (61e8474)\\n  broken: not scanned: Scorecard failed (exit code 1): repo is empty\\n  mobile-sdk-ios: Branch-Protection 5 (< 6): branch protection is not maximal on development and all release branches\\n  mobile-sdk-ios: Fuzzing 0 (< 10): project is not fuzzed\\n  mobile-sdk-ios: SAST: error: internal error: GraphQL timeout\\nNot configured in thresholds, ignored: Binary-Artifacts, CII-Best-Practices, Contributors, Dangerous-Workflow, Dependency-Update-Tool, License, Maintained, Packaging, Pinned-Dependencies, Signed-Releases, Token-Permissions, Vulnerabilities\\nScanned repositories: 3\\nFindings: 1 repository\\nErrors: 2 repositories\\n\\nJSON written to <tmp>/out/log.json\\n"
`;

