exports[`run > writes the README of the reports folder 1`] = `
"# Reports\\n\\nMonthly OSPO reports of the GitHub organisation \`test-org\`, one folder per month.\\n\\n<!-- Generated by scripts/reports_index.js (make create_reports). Do not edit by hand. -->\\n\\n## Compliance Reports: 2026-11\\n\\n- [Allianz Repository Standards](https://htmlpreview.github.io/?https://github.com/allianz/ospo/blob/main/reports/2026-11/allianz-report.html)\\n- [Other Guideline](https://htmlpreview.github.io/?https://github.com/allianz/ospo/blob/main/reports/2026-11/other-report.html)\\n\\n## Earlier months\\n\\n- [2026-10](2026-10/): [Allianz Repository Standards](https://htmlpreview.github.io/?https://github.com/allianz/ospo/blob/main/reports/2026-10/allianz-report.html)\\n"
`;

exports[`run > writes the README of the reports folder 2`] = `
"Reports index: 2 months, latest 2026-11\\n  2026-11: allianz, other\\n  2026-10: allianz\\nIndex written to <reports>/README.md\\n"
