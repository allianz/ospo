exports[`run > writes the README of the reports folder 1`] = `
"# Reports\\n\\nMonthly OSPO reports of the GitHub organisation \`test-org\`, one folder per month.\\n\\n<!-- Generated by scripts/reports_index.js (make create_reports). Do not edit by hand. -->\\n\\n## Latest: 2026-11\\n\\n- [BSI TR-03185 Chapter 2 Compliance Report](https://htmlpreview.github.io/?https://github.com/allianz/ospo/blob/main/reports/2026-11/bsi-report.html)\\n- [OpenSSF Scorecard Report](https://htmlpreview.github.io/?https://github.com/allianz/ospo/blob/main/reports/2026-11/scorecard-report.html)\\n\\n## Earlier months\\n\\n- [2026-10](2026-10/): [BSI TR-03185 Chapter 2 Compliance Report](https://htmlpreview.github.io/?https://github.com/allianz/ospo/blob/main/reports/2026-10/bsi-report.html)\\n"
`;

exports[`run > writes the README of the reports folder 2`] = `
"Reports index: 2 months, latest 2026-11\\n  2026-11: bsi, scorecard\\n  2026-10: bsi\\nIndex written to <reports>/README.md\\n"
`;
