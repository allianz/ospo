{
  "name": "ospo-scripts",
  "version": "1.0.0",
  "description": "OSPO automation scripts for GitHub organization management",
  "type": "module",
  "scripts": {
    "test": "node --test 'test/**/*.test.js'",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='*.js' --test-coverage-include='lib/**/*.js' --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 'test/**/*.test.js'",
    "test:update-snapshots": "node --test --test-update-snapshots 'test/**/*.test.js'"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "js-yaml": "^4.3.2",
    "simple-git": "^4.0.2"
  }
}
